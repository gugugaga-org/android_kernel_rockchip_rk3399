# KernelSU for the TPM312 Android TV box.
#
# The KernelSU driver sources are checked out next to the kernel tree as the
# kernel/rockchip/rk3399/KernelSU project and drivers/kernelsu is a symlink to
# its kernel/ directory.  Kernel 4.19 has no GKI hooks, so the driver uses the
# kprobe based integration.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KSU=y
